# Copy this file to .env and fill in real values.
# .env is gitignored — never commit credentials.

# --- Admin API key (required for /api/admin/* routes) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty to disable admin endpoints entirely.
ADMIN_API_KEY=

# --- OpenF1 authentication ---
# Set to true only when you have premium API access.
OPENF1_AUTH_ENABLED=false
OPENF1_USERNAME=
OPENF1_PASSWORD=

# --- Rate limits (premium tier: 6 req/s burst, 60 req/min sustained) ---
# MIN_INTERVAL: minimum seconds between consecutive HTTP requests (burst floor).
# For premium: 1/6 ≈ 0.167. For free tier: keep at 1.2 or higher.
OPENF1_MIN_INTERVAL=0.167
OPENF1_RATE_PER_SECOND=6
OPENF1_RATE_PER_MINUTE=60

# --- Retry / backoff ---
OPENF1_MAX_RETRIES=5
OPENF1_BACKOFF_BASE=2.0

# --- CORS (comma-separated, no spaces) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
